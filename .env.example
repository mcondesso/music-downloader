# Copy this file to .env and fill in the values below.

# Spotify OAuth (developer.spotify.com/dashboard) - PKCE public client, no
# client secret involved. Shared across everyone running this app; each person
# logs in individually with their own Spotify account against this client ID.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI_CLI=http://127.0.0.1:8080/callback
SPOTIFY_REDIRECT_URI_APP=http://127.0.0.1:8501

# YouTube Music OAuth (Google Cloud Console) - "Web application" OAuth client
# type, with the YouTube Data API v3 enabled and GOOGLE_REDIRECT_URI registered
# as an authorized redirect URI.
YOUTUBE_MUSIC_CLIENT_ID=
YOUTUBE_MUSIC_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8501
